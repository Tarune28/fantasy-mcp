<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the ESPN fantasy autopilot.

  Install:
    cp scripts/com.tarun.espn-fantasy-daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tarun.espn-fantasy-daily.plist

  Reload after editing:
    launchctl unload ~/Library/LaunchAgents/com.tarun.espn-fantasy-daily.plist
    launchctl load   ~/Library/LaunchAgents/com.tarun.espn-fantasy-daily.plist

  Run once now to test:
    launchctl start com.tarun.espn-fantasy-daily

  Times are in the machine's LOCAL time zone. The two runs below assume the goal
  is: a morning pass every day (injuries, free-agent upgrades, lineup) and a
  late-morning Sunday pass to lock in the optimal lineup just before the 1pm ET
  main slate. Adjust the hours to your time zone and league. Note: launchd only
  fires while the Mac is awake (a missed run fires once on wake).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tarun.espn-fantasy-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/taruneswar/Documents/Code/Projects/Tools/ESPN Fantasy MCP/scripts/run_daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Every day at 07:30 local: waivers/injuries/adds + lineup. -->
        <dict>
            <key>Hour</key><integer>7</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <!-- Sunday at 11:15 local: final lineup lock before the main slate.
             (Weekday 0 = Sunday.) -->
        <dict>
            <key>Weekday</key><integer>0</integer>
            <key>Hour</key><integer>11</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/taruneswar/Documents/Code/Projects/Tools/ESPN Fantasy MCP/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/taruneswar/Documents/Code/Projects/Tools/ESPN Fantasy MCP/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
